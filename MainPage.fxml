<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
    prefHeight="800.0"
    prefWidth="1200.0"
    style="-fx-background-color: #0c111b;"
    xmlns="http://javafx.com/javafx/17"
    xmlns:fx="http://javafx.com/fxml/1">


    <center>
        
        <ScrollPane
            hbarPolicy="NEVER"
            fitToWidth="true"
            style="-fx-background-color: #0c111b; -fx-background: #0c111b;">

            <content>
                <VBox spacing="32.0" style="-fx-background-color: #0c111b;">
                    <padding>
                        <Insets top="24.0" right="16.0" bottom="24.0" left="16.0" />
                    </padding>

                    <VBox spacing="10.0">
                        <Label text="Popular Films"
                               style="-fx-text-fill: white;
                                      -fx-font-size: 22px;
                                      -fx-font-weight: bold;" />
                        <HBox alignment="CENTER_LEFT" spacing="0.0">
                            
                            <Button fx:id="popularLeftBtn" text="&lt;"
                                    style="-fx-background-color: transparent;
                                           -fx-text-fill: white;
                                           -fx-font-size: 22px;
                                           -fx-cursor: hand;"
                                    prefWidth="32.0" />
                            
                            <ScrollPane fx:id="popularScroll"
                                        hbarPolicy="NEVER"
                                        vbarPolicy="NEVER"
                                        fitToHeight="true"
                                        HBox.hgrow="ALWAYS"
                                        style="-fx-background-color: #0c111b;
                                               -fx-background: #0c111b;">
                                <content>
                                    <HBox fx:id="popularRow" spacing="12.0"
                                          style="-fx-background-color: #0c111b;">
                                        <padding>
                                            <Insets top="4.0" bottom="8.0" />
                                        </padding>
                                    </HBox>
                                </content>
                            </ScrollPane>
                            
                            <Button fx:id="popularRightBtn" text="&gt;"
                                    style="-fx-background-color: transparent;
                                           -fx-text-fill: white;
                                           -fx-font-size: 22px;
                                           -fx-cursor: hand;"
                                    prefWidth="32.0" />
                        </HBox>
                    </VBox>

                    <!--   Latest Releases ── -->
                    <VBox spacing="10.0">
                        <Label text="Latest Releases"
                               style="-fx-text-fill: white;
                                      -fx-font-size: 22px;
                                      -fx-font-weight: bold;" />
                        <HBox alignment="CENTER_LEFT" spacing="0.0">
                            <Button fx:id="latestLeftBtn" text="&lt;"
                                    style="-fx-background-color: transparent;
                                           -fx-text-fill: white;
                                           -fx-font-size: 22px;
                                           -fx-cursor: hand;"
                                    prefWidth="32.0" />
                            <ScrollPane fx:id="latestScroll"
                                        hbarPolicy="NEVER"
                                        vbarPolicy="NEVER"
                                        fitToHeight="true"
                                        HBox.hgrow="ALWAYS"
                                        style="-fx-background-color: #0c111b;
                                               -fx-background: #0c111b;">
                                <content>
                                    <HBox fx:id="latestRow" spacing="12.0"
                                          style="-fx-background-color: #0c111b;">
                                        <padding>
                                            <Insets top="4.0" bottom="8.0" />
                                        </padding>
                                    </HBox>
                                </content>
                            </ScrollPane>
                            <Button fx:id="latestRightBtn" text="&gt;"
                                    style="-fx-background-color: transparent;
                                           -fx-text-fill: white;
                                           -fx-font-size: 22px;
                                           -fx-cursor: hand;"
                                    prefWidth="32.0" />
                        </HBox>
                    </VBox>

                    <VBox spacing="10.0">
                        <Label text="Recommendations from Friends"
                               style="-fx-text-fill: white;
                                      -fx-font-size: 22px;
                                      -fx-font-weight: bold;" />
                        <HBox alignment="CENTER_LEFT" spacing="0.0">
                            <Button fx:id="friendsLeftBtn" text="&lt;"
                                    style="-fx-background-color: transparent;
                                           -fx-text-fill: white;
                                           -fx-font-size: 22px;
                                           -fx-cursor: hand;"
                                    prefWidth="32.0" />
                            <ScrollPane fx:id="friendsScroll"
                                        hbarPolicy="NEVER"
                                        vbarPolicy="NEVER"
                                        fitToHeight="true"
                                        HBox.hgrow="ALWAYS"
                                        style="-fx-background-color: #0c111b;
                                               -fx-background: #0c111b;">
                                <content>
                                    <HBox fx:id="friendsRow" spacing="12.0"
                                          style="-fx-background-color: #0c111b;">
                                        <padding>
                                            <Insets top="4.0" bottom="8.0" />
                                        </padding>
                                    </HBox>
                                </content>
                            </ScrollPane>
                            <Button fx:id="friendsRightBtn" text="&gt;"
                                    style="-fx-background-color: transparent;
                                           -fx-text-fill: white;
                                           -fx-font-size: 22px;
                                           -fx-cursor: hand;"
                                    prefWidth="32.0" />
                        </HBox>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
