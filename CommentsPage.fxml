<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.controlsfx.control.Rating?>

<BorderPane prefHeight="700.0" prefWidth="900.0" style="-fx-background-color: #0c111b;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <!-- Geri butonu -->
    <top>
        <HBox prefHeight="40.0" style="-fx-background-color: #0c111b;">
            <Button fx:id="backBtn" mnemonicParsing="false" style="-fx-background-color: transparent;                        -fx-text-fill: white;                        -fx-font-size: 20px;                        -fx-font-weight: bold;                        -fx-cursor: hand;" text="&lt;">
                <HBox.margin>
                    <Insets left="14.0" top="6.0" />
                </HBox.margin>
            </Button>
        </HBox>
    </top>

    <!-- Yorumlar listesi -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #0c111b; -fx-background: #0c111b;" BorderPane.alignment="CENTER">
            <content>
                <VBox fx:id="commentsContainer" spacing="16.0" style="-fx-background-color: #0c111b;">
                    <padding>
                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <!-- Alt kisim: Rating + TextArea + Send -->
    <bottom>
        <VBox fx:id="bottomVBox" style="-fx-background-color: #0c111b; -fx-border-color: #1e2d47;   -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets bottom="10.0" left="16.0" right="16.0" top="8.0" />
            </padding>

            <Rating fx:id="starRating" rating="0.0" style="-fx-background-color: transparent;">
                <VBox.margin>
                    <Insets bottom="6.0" left="4.0" />
                </VBox.margin>
            <padding>
               <Insets left="20.0" />
            </padding>
            </Rating>

            <HBox fx:id="commentSendHBox" alignment="CENTER" spacing="8.0">

                <TextArea fx:id="commentArea" prefHeight="90.0" promptText="Add your comment..." style="-fx-control-inner-background: #0c111b; -fx-text-fill: white; -fx-prompt-text-fill: #6b7a99; -fx-font-size: 15px;" wrapText="true" HBox.hgrow="SOMETIMES">
                    <HBox.margin>
                        <Insets left="4.0" />
                    </HBox.margin>
                    <font>
                        <Font size="14.0" />
                    </font>
                </TextArea>

                <Button fx:id="addCommentBtn" mnemonicParsing="false" text="Add Comment">
                    <HBox.margin>
                        <Insets right="4.0" />
                    </HBox.margin>
               <font>
                  <Font size="15.0" />
               </font>
                </Button>

            </HBox>
        </VBox>
    </bottom>

</BorderPane>
